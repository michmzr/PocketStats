#!/bin/sh
# Only the public API base belongs in browser configuration, never backend keys.
set -eu
export LC_ALL=C
umask 077

reject() {
    echo 'PocketStats frontend configuration rejected' >&2
    exit 78
}

url=${VUE_APP_BACKEND_URL:-}
case "$url" in *\\*) reject ;; esac
# A single-line URL alphabet excludes JavaScript/HTML quoting and escapes.
printf '%s\n' "$url" | awk '
    BEGIN { ok=1 }
    !/^[A-Za-z0-9._~:\/@!$&()*+,;=%-]*$/ { ok=0 }
    END { exit !(ok && NR==1) }
' || reject
case "$url" in
    //*) reject ;;
    ''|/|/?*|http://?*|https://?*) ;;
    *) reject ;;
esac
url=${url%/}

mkdir -p /tmp/pocketstats-ui
printf 'window.POCKETSTATS_CONFIG={"backendUrl":"%s","privateDashboard":false};\n' "$url" \
    > /tmp/pocketstats-ui/runtime-config.js
exec nginx -c /etc/nginx/nginx.conf -g 'daemon off;'
